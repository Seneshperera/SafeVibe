# Copy to .env (never commit .env)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
MAX_TEXT_CHARS=5000
MAX_URLS=10
MAX_CONVERSATION_MESSAGES=50
# Threat-intel keys go here later (server-side only)
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
CONNECTOR_TIMEOUT_SECONDS=5

# Local default is SQLite. For deployment paste your Neon/Supabase Postgres URL here.
# DATABASE_URL=sqlite:///./safevibe.db
# Enables GET /api/v1/audit (send it as the X-Operator-Key header). Use a long random value.
OPERATOR_KEY=
